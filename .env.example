SECRET_KEY=changeme
DEBUG=0
DJANGO_ALLOWED_HOSTS=your.domain.com
CSRF_TRUSTED_ORIGINS=https://your.domain.com

# Origins (scheme + host [+ port]) allowed to make cross-origin requests to the API,
# e.g. a frontend served from a different host/port.
# CORS_ALLOWED_ORIGINS=http://localhost:8097,https://your.domain.com

# For HTTP-only (non-TLS) deployments, set to "none" to stop Django from sending a
# Cross-Origin-Opener-Policy header that browsers ignore (and warn about) over plain HTTP.
# SECURE_CROSS_ORIGIN_OPENER_POLICY=none

POSTGRES_DB=pyobs
POSTGRES_USER=pyobs
POSTGRES_PASSWORD=secret

DATABASE=postgres
SQL_ENGINE=django.db.backends.postgresql
SQL_HOST=db
SQL_PORT=5432
STATIC_ROOT=/src/static

CELERY_BROKER_URL=amqp://rabbitmq//
CELERY_RESULT_BACKEND=rpc://

# Uncomment to enable the web frontend
# ENABLE_FRONTEND=1

# Observatory location (required for day/night timeline on dashboard)
# SITE_LATITUDE=48.0
# SITE_LONGITUDE=11.5
# SITE_ELEVATION=0

# Default constraints/merits pre-filled when creating a new task (JSON arrays).
# DEFAULT_CONSTRAINTS=[{"class":"pyobs.robotic.scheduler.constraints.AirmassConstraint","max_airmass":2.0}]
# DEFAULT_MERITS=[]

# Keycloak login (optional addon on top of local Django username/password and Token auth, not a
# replacement - leave SERVER_URL unset to disable it entirely; the login page won't show the
# button either).
# KEYCLOAK_SERVER_URL=https://keycloak.example.org
# KEYCLOAK_REALM=pyobs
# KEYCLOAK_CLIENT_ID=robotic-backend
# KEYCLOAK_CLIENT_SECRET=
# KEYCLOAK_REDIRECT_URI=https://your.domain.com/accounts/keycloak/callback/
# KEYCLOAK_POST_LOGOUT_REDIRECT_URI=https://your.domain.com/
# Optional one-click IdP login: hint passed to Keycloak as kc_idp_hint (skips its
# login/IdP-selection page, going straight to that identity provider) plus the label
# shown on the login page's IdP button.
# KEYCLOAK_IDP_HINT=gwdg
# KEYCLOAK_IDP_LABEL=GWDG

# Settings-configured superuser (optional), synced automatically after every `migrate` -
# skips the interactive `createsuperuser` step. Leave ADMIN_USERNAME unset to opt out.
# Generate the hash: uv run python -c \
#   "from django.contrib.auth.hashers import make_password; print(make_password('yourpassword'))"
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD_HASH=

# pyobs-archive integration (optional): links each completed/aborted/failed observation to its
# archived data. ARCHIVE_URL alone is enough for the links; ARCHIVE_TOKEN additionally enables
# the on-demand frame-count/reduction-status check.
# ARCHIVE_URL=https://archive.example.org
# ARCHIVE_TOKEN=
